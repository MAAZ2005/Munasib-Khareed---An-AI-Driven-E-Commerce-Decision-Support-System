# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints & cache
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Environment variables & local secrets
.env
.env.*
!.env.example

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor caches
.vscode/
.idea/
*.swp
*.swo

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Data directory contents (ignore data files while retaining directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/db/*
!data/db/.gitkeep

# Models directory contents (ignore model weights / checkpoints while retaining directory structure)
models/*
!models/.gitkeep

# SQLite database files
*.sqlite
*.sqlite3
*.db

# Streamlit run cache / secrets
.streamlit/secrets.toml

# Documentation and project proposal (must never be ignored)
!docs/
!docs/proposal.pdf

logs/
