# ==============================================================================
# Munasib Khareed - Environment Variables Template
# ==============================================================================
# Copy this file to .env to override default configuration values locally.

# Application Environment (development, staging, production)
MUNASIB_ENVIRONMENT=development

# Master Configuration File Path
MUNASIB_CONFIG_PATH=configs/config.yaml

# API Server Settings
MUNASIB_API_HOST=127.0.0.1
MUNASIB_API_PORT=8000

# SQLite Serving Cache Path
MUNASIB_DB_PATH=data/db/serving_cache.sqlite

# Logging
MUNASIB_LOG_LEVEL=INFO

# Random Seed for Reproducibility
MUNASIB_RANDOM_SEED=42
